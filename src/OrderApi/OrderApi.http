@OrderApi_HostAddress = http://localhost:5190
# Get a token from AuthApi (POST http://localhost:5250/auth/login) and paste it here.
@token = paste-accessToken-here

GET {{OrderApi_HostAddress}}/health
Accept: application/json

###

GET {{OrderApi_HostAddress}}/orders
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{OrderApi_HostAddress}}/orders/1
Authorization: Bearer {{token}}
Accept: application/json

###

POST {{OrderApi_HostAddress}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": 1,
  "quantity": 2
}

###

GET {{OrderApi_HostAddress}}/security/me
Authorization: Bearer {{token}}
